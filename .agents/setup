#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")/.."

echo "Installing libvips and fonts from mise.toml"
mise trust mise.toml
mise bootstrap packages apply --manager apt --yes

echo "Installing Ruby from .ruby-version"
mise install

echo "Installing gems from Gemfile.lock"
mise exec -- bundle install
echo "Blog setup finished in ${SECONDS}s"
